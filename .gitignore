# Local config (copy from config/pipeline.example.yaml)
config/pipeline.yaml

# Data products — fetched from MAST / Zenodo, never committed
data/
logs/
*.h5
*.fits
*.fits.gz
crds_cache/

# Production working tree (this clone shares a directory with the machine's
# production pipeline; these dirs are the real science code and must never be
# committed into the public package — pipeline/ + scripts/ are the ported ones)
/core/
/analysis/
/preprocessing/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# Demo outputs
demo/*.png
demo/output/

# OS
.DS_Store
